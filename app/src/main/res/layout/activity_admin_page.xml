<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    tools:context=".AdminPage">

    <!-- 🔥 Toolbar חובה לתפריט ⋮ -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#FFFFFF"
        app:title="דף מנהל"
        app:titleTextColor="#2C3E50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/backhome1"
        android:alpha="0.3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btnHamburgerMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:text="☰"
        android:textColor="#2C3E50"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/adminPanelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="90dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#FFFFFF">

            <!-- 👇 השם של המנהל -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="שלום מנהל"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/adminTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="דף מנהל"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="40dp"
                android:textColor="#2C3E50"/>

            <!-- כפתורים גדולים יותר -->
            <Button
                android:id="@+id/btnAddItem"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="הוספת פריט"
                android:layout_marginBottom="20dp"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#81D4FA"/>

            <Button
                android:id="@+id/btnItems"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="כל הפריטים"
                android:layout_marginBottom="20dp"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#B3E5FC"/>

            <Button
                android:id="@+id/btnUserTable"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="משתמשים"
                android:layout_marginBottom="20dp"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#E1F5FE"/>

            <Button
                android:id="@+id/btnAllShakes"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="כל השייקים"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#B3E5FC"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- כפתור התנתקות -->
    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="התנתקות"
        android:textStyle="bold"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#81D4FA"
        app:layout_constraintTop_toBottomOf="@id/adminPanelCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>